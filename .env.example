# Environment configuration for Sarla Hooda LIC Insurance Website & Smart CRM
# Do not store production secrets in this file.

# Port for local Express development / production server (default: 3000)
PORT=3000
NODE_ENV=development

# JWT Secret for secure Admin CRM authentication sessions
# Replace with a cryptographically secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY

# APP_URL: Public URL where this applet is hosted
APP_URL=https://your-domain.com

# Optional Gemini API key if AI assistance features are enabled
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
