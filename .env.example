# Environment Configuration for Sarla Hooda LIC Insurance Website & Smart CRM
# Do NOT store production secrets in this file. Copy to .env or add to Vercel Project Settings.

# -----------------------------------------------------------------------------
# 1. AUTHENTICATION & SECURITY (Required in Production)
# -----------------------------------------------------------------------------
# JWT Secret used for signing and verifying Admin CRM bearer tokens.
# Generate a cryptographically secure random string (e.g., `openssl rand -base64 32`).
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY

# Primary Administrator Credentials for CRM Access:
# Configure custom admin email and password in Vercel Environment Variables.
# If omitted, defaults to verified advisor credentials (sarla.hooda@licadvisor.in).
ADMIN_EMAIL=sarla.hooda@licadvisor.in
ADMIN_DEFAULT_EMAIL=sarla.hooda@licadvisor.in
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
ADMIN_DEFAULT_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT
# -----------------------------------------------------------------------------
# Node environment ('development' | 'production')
NODE_ENV=production

# Server port for local development / VPS / Cloud Run / Docker (Vercel automatically sets PORT)
PORT=3000

# Canonical public production URL of your deployed application
APP_URL=https://your-project.vercel.app

# -----------------------------------------------------------------------------
# 3. DATA PERSISTENCE & DATABASE NOTES
# -----------------------------------------------------------------------------
# On Vercel, the application automatically routes database reads and writes to
# `/tmp/sarla_crm_data/app_database.json` to prevent read-only filesystem errors.
#
# NOTE ON VERCEL SERVERLESS PERSISTENCE:
# Vercel Serverless Functions have ephemeral local storage. While /tmp holds state
# during function execution, lambda instances recycle on cold starts.
# For permanent cross-session multi-region persistence on Vercel, connect an
# external cloud database service (e.g., Neon Postgres, Supabase, Cloud SQL, or MongoDB Atlas):
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# 4. OPTIONAL AI & INTEGRATION KEYS
# -----------------------------------------------------------------------------
# Optional Gemini API key if AI assistance features are enabled
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
